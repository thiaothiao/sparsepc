#ifndef SPARSELY_VERSION_HPP
#define SPARSELY_VERSION_HPP

#include <string_view>

namespace sparsely 
{
	namespace meta 
	{
		inline constexpr std::string_view APP_VERSION = "@PROJECT_VERSION@";
		inline constexpr std::string_view APP_NAME    = "@PROJECT_NAME@";
		inline constexpr std::string_view VENDOR      = "@PROJECT_VENDOR@";
		inline constexpr std::string_view BUILD_TIME  = "@BUILD_TIMESTAMP@";
		inline constexpr std::string_view PROJECT_DESCRIPTION = "@PROJECT_DESCRIPTION@";
	}
}

#endif //SPARSELY_VERSION_HPP
