#ifndef SPARSELY_VERSION_HPP
#define SPARSELY_VERSION_HPP

#include <string_view>

namespace sparsely 
{
	namespace metadata 
	{
	        inline constexpr std::string_view appVersion = "@appVersion@";
		inline constexpr std::string_view exeName    = "@exeName@";
		inline constexpr std::string_view appName    = "@appName@";
		inline constexpr std::string_view appVendor  = "@appVendor@";
		inline constexpr std::string_view buildTime  = "@buildTime@";
		inline constexpr std::string_view appTitle   = "@appTitle@";
		inline constexpr std::string_view appDomain  = "@appDomain@";
	}
}

#endif //SPARSELY_VERSION_HPP
