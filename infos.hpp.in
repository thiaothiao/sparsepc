#ifndef SPARSEPC_VERSION_HPP
#define SPARSEPC_VERSION_HPP

#include <string_view>

set(libraryName "Sparsepc")
set(libName "sparsepc")
set(libVersion "0.1.0")
set(libTitle "Sparse principal component C++ Library")
set(libVendor "Indilo")
set(libDomain "?.com")
string(TIMESTAMP buildTime "%Y-%m-%d %H:%M:%S")

namespace sparsepc
{
	namespace metadata 
	{
		inline constexpr std::string_view libVersion = "@libVersion@";
		inline constexpr std::string_view libName    = "@libName@";
		inline constexpr std::string_view libraryName    = "@libraryName@";
		inline constexpr std::string_view libVendor  = "@libVendor@";
		inline constexpr std::string_view buildTime  = "@buildTime@";
		inline constexpr std::string_view libTitle   = "@libTitle@";
		inline constexpr std::string_view libDomain  = "@libDomain@";
	}
}

#endif //SPARSEPC_VERSION_HPP
